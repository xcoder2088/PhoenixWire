# Copy to ~/.config/phoenixwire/local.env and chmod 600 that file.
# No real credentials belong in this repository.
PHOENIXWIRE_ENABLE_PAYMENTS=1
PHOENIXWIRE_ADDR=127.0.0.1:8790
PHOENIXWIRE_PUBLIC_URL=http://127.0.0.1:8790
MAILERSEND_API_KEY=
MAILERSEND_FROM=
NIMIQ_CLAIM_MAINNET_RPC_URL=
# Optional private absolute directories, separate from PhoenixMail's funded state.
# PHOENIXWIRE_STATE_DIR=/absolute/private/phoenixwire-state
# PHOENIXWIRE_CONFIG_DIR=/absolute/private/phoenixwire-config

# Who may send. Administrators (comma-separated) get the "Administration" panel and can always sign in.
# PHOENIXWIRE_ADMINS=owner@example.com
# Extra addresses allowed to send besides the registered senders; "open" forces sending open to everyone (the admin panel cannot close it then).
# PHOENIXWIRE_SENDERS=friend@example.com,other@example.com
# Optional tuning of the USDC/USDT fees (defaults: 600 = 6 %, margin 1.5 on the gas part; see docs/FIN-DES-CARTES.md).
# NIMIQ_CLAIM_USDTLINK_FEE_BPS=600
# NIMIQ_CLAIM_USDTLINK_FEE_MARGIN=1.5
# NIMIQ_CLAIM_USDTLINK_COINGECKO=off
