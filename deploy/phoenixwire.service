[Unit]
Description=Phoenix Wire
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phoenixwire
Group=phoenixwire
WorkingDirectory=/opt/phoenixwire
ExecStart=/opt/phoenixwire/phoenixwire
EnvironmentFile=/etc/phoenixwire/local.env
Environment=PHOENIXWIRE_ADDR=127.0.0.1:8790
Environment=PHOENIXWIRE_CONFIG_DIR=/etc/phoenixwire
Environment=PHOENIXWIRE_STATE_DIR=/var/lib/phoenixwire
ConfigurationDirectory=phoenixwire
ConfigurationDirectoryMode=0700
StateDirectory=phoenixwire
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/phoenixwire /var/lib/phoenixwire
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
